# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/
ENV/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/

# Env / secrets
.env
.env.*
!.env.example
*.local
secrets.json
credentials.json
*credentials*.json
*.pem
*.key
*.p12
*.pfx
id_rsa*
*_token.json
*_api_key.json
.netrc

# Logs (todos) -- se regeneran solos, nunca son codigo fuente
*.log
*.log.*

# Estado local del agente Claude Code (worktrees, settings locales) -- copias
# completas del repo y config de esta maquina, no son parte del proyecto.
.claude/

# Grabaciones de pantalla del agente (backend/app/recording.py) -- binarios
# grandes que se regeneran en cada corrida.
content/recordings/
*.mp4
*.mkv
*.mov
*.avi

# Capturas sueltas de escritorio (artefacto de debug, se regenera)
backend/desktop_screenshot.png

# Documentos Word personales sueltos en la raiz (ver docs/*.docx mas abajo)
/*.docx

# Autorización de pentesting activo -- local a cada instalación, nunca en git
# (ver backend/authorized_targets.yaml.example para el template)
backend/authorized_targets.yaml
backend/sqlmap_api_credentials.json
backend/zap_api_key.json

# Playwright
backend/last_screenshot.png
test-results/

# Tray app
tray-app/backend.log
tray-app/voice.log
# Grabaciones reales de voz juntadas para diagnosticar/reentrenar el wake word
# (ver SampleRecorder.kt) -- audio real de Damian, nunca se publica.
tray-app/voice_debug/

# ComfyUI (generate_image/generate_video): log de stdout/stderr del subproceso,
# se regenera solo (ver _comfyui_shared.py).
backend/comfyui.log

# stdout/stderr del backend cuando se arranca manualmente (fuera de la tray app)
# redirigidos a archivo para evitar que el pipe se llene y cuelgue el proceso.
backend/backend_stdout.log
backend/backend_stderr.log

# Logs de AIDA64 (temperaturas/voltajes) -- telemetría local de esta máquina
# para diagnosticar apagados físicos durante cargas de GPU, ver INFORME_COMPLETO.md
# sección 4.5. No son datos del proyecto, no se publican.
backend/hw_monitor_logs/

# Notas internas del agente (backend/app/tools/reflect.py) -- pueden contener
# preferencias y detalles personales del usuario, no son para publicar.
backend/reflections.jsonl

# Vault de notas Obsidian (backend/app/obsidian/) -- por defecto privado
# (contenido personal del usuario y del agente, igual criterio que
# reflections.jsonl arriba). Excepción: backend/obsidian_vault/jarvis/ es
# base de conocimiento de ciberseguridad, pensada para ser pública -- se
# habilita explícitamente abajo. backend/obsidian_vault/human/ (notas
# personales de Damian) permanece privado.
backend/obsidian_vault/*
!backend/obsidian_vault/jarvis/

# Dentro de jarvis/, estas dos notas son decisiones de arquitectura interna
# (no ciberseguridad) -- quedan privadas hasta confirmar si también deben
# publicarse.
backend/obsidian_vault/jarvis/decision-tree-sitter-para-indexar-codebase.md
backend/obsidian_vault/jarvis/vault-de-obsidian-con-autoria-separada.md

# Cache de índices de codebase (backend/app/codebase/store.py) -- se
# regenera solo, y puede referenciar rutas/proyectos privados del usuario.
backend/data/

# Artefactos de build/test sueltos en la raíz -- no son parte del código fuente
# (el APK se genera con android-app/deploy.ps1; el .onnx es un duplicado de
# tray-app/models/hey_jarvis.onnx).
/installed.apk
/installed_hey_jarvis.onnx

# Log de auditoría estructurado (backend/app/audit_log.py), rota por tamaño
backend/audit.log*

# Certificado TLS self-signed (backend/certs/generate_cert.sh regenera esto) —
# la clave privada nunca se commitea. El script y el README de esa carpeta sí.
backend/certs/*.pem

# Android
android-app/.gradle/
android-app/local.properties
android-app/*/build/
android-app/.idea/

# OS
Thumbs.db
.DS_Store

# Informes en Word generados para uso personal (docs/ solo trackea el diagrama
# de arquitectura, que sí se usa en README.md).
docs/*.docx
