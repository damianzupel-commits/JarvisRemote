# IP/host donde escucha el backend. Poné acá tu IP de Tailscale (tailscale ip -4)
# para que el server NO sea alcanzable fuera de tu tailnet. 0.0.0.0 también funciona
# si confiás en el firewall de Windows, pero la IP de Tailscale es más a prueba de balas.
HOST=0.0.0.0
PORT=8000

# Token que tiene que mandar el celular en el header "Authorization: Bearer <API_KEY>".
# Si lo dejás vacío, se genera uno random al arrancar y se imprime en consola
# (pero no persiste entre reinicios: conviene fijarlo acá).
API_KEY=

# LM Studio: servidor local -> Developer/Local Server -> Start Server (default 1234).
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Nombre del modelo tal como lo lista LM Studio (GET /v1/models). Muchos servers
# de LM Studio ignoran este campo y usan el modelo cargado, pero conviene setearlo.
LMSTUDIO_MODEL=local-model

# Carpeta raíz a la que quedan restringidas las tools de filesystem.
# Cualquier path fuera de esta carpeta es rechazado.
FS_ALLOWED_ROOT=C:\Users\dam

# Las operaciones destructivas (borrar archivos/carpetas) están apagadas por default.
FS_ALLOW_DELETE=false

# Si el navegador automatizado se ve (false) o corre headless (true).
BROWSER_HEADLESS=false

# Control invasivo del escritorio de la PC (mouse/teclado/ventanas de cualquier
# programa, ver app/tools/desktop.py y la sección de seguridad en README.md).
# Prendido por default a pedido explícito del usuario. Poner en false para
# desactivar todas las tools desktop_* sin tocar código.
DESKTOP_CONTROL_ENABLED=true

# Ejecución de shell REAL en el celular vía Termux (ver app/tools/phone.py::
# phone_run_command y la sección de seguridad en README.md). El nivel más
# invasivo posible del lado del celular — código arbitrario, no solo UI.
# Prendido por default a pedido explícito del usuario. Poner en false para
# desactivar phone_run_command sin tocar código. Requiere además pasos
# manuales del lado del celular (Termux instalado + configurado + permiso
# otorgado) que este flag no reemplaza.
PHONE_SHELL_ENABLED=true

# Tope de iteraciones del loop del agente (llamada a LLM -> tool -> llamada a LLM -> ...)
# antes de cortar, para evitar loops infinitos.
MAX_AGENT_ITERATIONS=10

# TLS (wss:// en vez de ws:// en texto plano) — PREPARADO PERO NO ACTIVAR SOLO.
# Activar esto sin haber hecho primero el trabajo del lado de Android (confiar
# en el cert self-signed) corta el acceso de la app hasta revertirlo. Ver
# backend/certs/README.md para el procedimiento completo antes de tocar esto.
TLS_ENABLED=false
# TLS_CERT_PATH=backend/certs/cert.pem   (default si no se setea)
# TLS_KEY_PATH=backend/certs/key.pem     (default si no se setea)
