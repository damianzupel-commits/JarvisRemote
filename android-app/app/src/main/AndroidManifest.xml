<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
    Permiso "dangerous" que define la app Termux para su Intent RUN_COMMAND
    (ver phone/TermuxCommandRunner.kt). Solo lo puede otorgar el usuario (desde
    Ajustes de Jarvis o a mano en Ajustes de Android) y solo tiene efecto si
    Termux está instalado, ya que es Termux quien define este permiso.
    -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <!--
    Permiso "dangerous" para que Jarvis pueda tomar fotos en silencio con la cámara
    del celular (phone_take_photo, ver phone/PhoneCamera.kt). Se pide en runtime
    desde Ajustes, igual que el permiso de Termux. `required="false"` en la feature
    para que la app siga instalable en un dispositivo sin cámara (poco probable acá,
    pero es la práctica correcta).
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />

    <!--
    Escucha continua de "hey Jarvis" (ver voice/VoiceListenerService.kt).
    RECORD_AUDIO es "dangerous" y se pide en runtime desde Ajustes, igual que
    la cámara. FOREGROUND_SERVICE_MICROPHONE es obligatorio para declarar el
    service con foregroundServiceType="microphone" apuntando a API 34.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Vibración como confirmación de wake word (nivel normal, no requiere grant). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!--
    Necesario para que PackageManager.getLaunchIntentForPackage funcione con
    cualquier app instalada (phone_open_app): a partir de Android 11, un paquete
    solo es "visible" para otro si hay una declaración <queries> que lo cubra.
    Esto declara visibilidad sobre cualquier app con ícono de launcher.

    El <package> de Termux es aparte: lanzar su RunCommandService es un intent
    explícito (setClassName), que no necesita <queries> — pero sí hace falta
    para poder chequear con PackageManager si Termux está instalado
    (TermuxCommandRunner.isTermuxInstalled), si no getPackageInfo tira
    NameNotFoundException aunque esté instalado.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.termux" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.JarvisRemote"
        android:usesCleartextTraffic="true">
        <!--
        usesCleartextTraffic: el backend habla HTTP plano (no HTTPS) en la IP de
        Tailscale. Ese tráfico ya viaja cifrado dentro del túnel WireGuard de
        Tailscale y nunca sale a internet, así que permitir cleartext acá es
        aceptable para este caso de uso privado. Si el backend alguna vez queda
        detrás de HTTPS, se puede sacar este flag.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.JarvisRemote">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
        Control genérico de pantalla (tap/swipe/type/read/global-action) sobre
        cualquier app visible. El usuario tiene que habilitarlo a mano en Ajustes
        → Accesibilidad; no se puede activar programáticamente. Ver
        `phone/JarvisAccessibilityService.kt` y `res/xml/accessibility_service_config.xml`.
        -->
        <service
            android:name=".phone.JarvisAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!--
        Foreground service que mantiene la conexión WebSocket saliente con el
        backend (`/ws/phone`). Tipo "dataSync": sincroniza tool calls/resultados
        con un servidor remoto mientras la app no está en primer plano.
        -->
        <service
            android:name=".phone.PhoneLinkService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!--
        Escucha continua de "hey Jarvis" (wake word on-device + SpeechRecognizer).
        Tipo "microphone": Android 14+ solo permite arrancarlo con la app visible
        (se arranca desde el toggle de Ajustes) y NUNCA desde BOOT_COMPLETED — por
        eso BootReceiver no lo levanta y tras un reinicio hay que abrir la app una
        vez para reactivarlo. Ver el docstring de VoiceListenerService.
        -->
        <service
            android:name=".voice.VoiceListenerService"
            android:foregroundServiceType="microphone"
            android:exported="false" />

        <!--
        Solo recibe el resultado asincrónico de un comando RUN_COMMAND corrido en
        Termux, vía el PendingIntent que le manda TermuxCommandRunner. No exportado:
        Termux invoca el PendingIntent directamente (identidad a nivel de SO), no
        hace falta declarar visibilidad de intent-filter para eso.
        -->
        <service
            android:name=".phone.TermuxResultService"
            android:exported="false" />

        <receiver
            android:name=".phone.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
